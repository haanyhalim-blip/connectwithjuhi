// Cloudflare Worker settings for connectwithjuhi.com.
// The whole site is index.html, served as a static file.
// Deploy command in Cloudflare: npx wrangler deploy   (no build command)
// Cloudflare Workers Builds deploys automatically on every push to main.
{
  "name": "connectwithjuhi",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./"
  }
}
